#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
pnpm app:build
mkdir -p build/wallcarousel/{bin,libexec,share/icons}
cp src-tauri/target/release/app build/wallcarousel/libexec/wallcarousel
cp src-tauri/icons/wall_icon.png build/wallcarousel/share/icons/wallcarousel.png
# Preserve the Nix runtime libraries for launches outside the development shell.
{
  printf '#!/usr/bin/env bash\nset -euo pipefail\n'
  printf 'export LD_LIBRARY_PATH=%q\n' "${LD_LIBRARY_PATH:-}"
  printf 'export PATH=%q:"$PATH"\n' "$(dirname "$(command -v awww)")"
  printf 'exec "$(dirname "$(readlink -f "$0")")/../libexec/wallcarousel" "$@"\n'
} > build/wallcarousel/bin/wallcarousel
chmod +x build/wallcarousel/bin/wallcarousel
printf 'Built application directory: %s/build/wallcarousel\n' "$PWD"
